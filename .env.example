DATABASE_URL=postgresql://remindly:remindly@localhost:5433/remindly?schema=public
# Prisma CLI migrations use this direct/session connection. Supabase deployments
# should use the direct database URL here, while DATABASE_URL uses the pooler.
DIRECT_URL=postgresql://remindly:remindly@localhost:5433/remindly?schema=public
# Supabase project URL and public publishable key. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Auth.js signs sessions with this server-only secret.
AUTH_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=owner@example.com
# Store only a bcrypt hash, never the owner's plaintext password.
OWNER_PASSWORD_HASH=replace-with-bcrypt-hash
SCHEDULER_SECRET=replace-with-a-random-scheduler-secret
RESEND_API_KEY=re_example
# Must be a sender identity verified by the configured email provider.
RESEND_FROM=Remindly <reminders@example.com>
APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
