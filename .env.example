DATABASE_URL=postgresql://remindly:remindly@localhost:5433/remindly?schema=public
# Prisma CLI migrations use this direct/session connection. Supabase deployments
# should use the direct database URL here, while DATABASE_URL uses the pooler.
DIRECT_URL=postgresql://remindly:remindly@localhost:5433/remindly?schema=public
# Supabase project URL and public publishable key. The secret key is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Supabase Auth owns sessions, passwords, and email verification.
# Used only by the legacy local seed until profile synchronization is enabled.
OWNER_EMAIL=owner@example.com
SCHEDULER_SECRET=replace-with-a-random-scheduler-secret
RESEND_API_KEY=re_example
# Must be a sender identity verified by the configured email provider.
RESEND_FROM=Remindly <reminders@example.com>
# Gmail delivery is enabled only after the provider and budget cutover gates pass.
GMAIL_CLIENT_ID=replace-with-google-oauth-client-id
GMAIL_CLIENT_SECRET=replace-with-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=replace-with-offline-refresh-token
GMAIL_SENDER_EMAIL=remindly.notifications@gmail.com
GMAIL_SENDER_NAME=Remindly
# Keep these below the provider's account limits and reserve capacity for Auth mail.
GMAIL_TOTAL_DAILY_BUDGET=350
GMAIL_AUTH_RESERVE=50
GMAIL_REQUEST_TIMEOUT_MS=10000
GMAIL_AUTH_HOOK_TOTAL_TIMEOUT_MS=4000
APP_URL=http://localhost:3000
